{
  "name": "@alien6-studio/elea-tokens",
  "version": "0.1.2",
  "description": "Elea design tokens: DTCG 2025.10 exports, CSS custom properties, Tailwind v3 preset and v4 theme, shadcn/ui aliases and TypeScript constants",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Alien6-Studio/elea.git",
    "directory": "packages/tokens"
  },
  "files": [
    "dist",
    "tokens",
    "typography.css",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    },
    "./brand": {
      "types": "./dist/src/brand.d.ts",
      "import": "./dist/src/brand.js",
      "default": "./dist/src/brand.js"
    },
    "./palette": {
      "types": "./dist/src/palette.d.ts",
      "import": "./dist/src/palette.js",
      "default": "./dist/src/palette.js"
    },
    "./qualification": {
      "types": "./dist/src/qualification.d.ts",
      "import": "./dist/src/qualification.js",
      "default": "./dist/src/qualification.js"
    },
    "./typography.css": "./typography.css",
    "./palette.css": "./dist/palette.css",
    "./elea.css": "./dist/elea.css",
    "./fonts/elea-sans.css": "./dist/fonts/elea-sans.css",
    "./fonts/ELEASans-Variable.woff2": "./dist/fonts/ELEASans-Variable.woff2",
    "./fonts/ELEASans-Italic-Variable.woff2": "./dist/fonts/ELEASans-Italic-Variable.woff2",
    "./editions.css": "./dist/editions.css",
    "./theme.css": "./dist/theme.css",
    "./tailwind": {
      "types": "./dist/tailwind.d.ts",
      "import": "./dist/tailwind.js",
      "default": "./dist/tailwind.js"
    },
    "./shadcn.css": "./dist/shadcn.css",
    "./tokens/elea.tokens.json": "./tokens/elea.tokens.json",
    "./tokens/elea.dark.tokens.json": "./tokens/elea.dark.tokens.json",
    "./dtcg/2025.10/elea.tokens.json": "./dist/dtcg/2025.10/elea.tokens.json",
    "./dtcg/2025.10/elea.dark.tokens.json": "./dist/dtcg/2025.10/elea.dark.tokens.json",
    "./package.json": "./package.json"
  },
  "types": "./dist/src/index.d.ts",
  "main": "./dist/src/index.js",
  "scripts": {
    "export:dtcg": "node --import tsx scripts/export-dtcg.ts",
    "build": "tsc -p tsconfig.build.json && node --import tsx scripts/build-css.ts && npm run export:dtcg",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {},
  "peerDependencies": {},
  "publishConfig": {
    "access": "public"
  },
  "license": "Apache-2.0",
  "homepage": "https://github.com/Alien6-Studio/elea/tree/main/packages/tokens",
  "bugs": {
    "url": "https://github.com/Alien6-Studio/elea/issues"
  },
  "keywords": [
    "elea",
    "design-system",
    "design-tokens",
    "css",
    "tailwind"
  ]
}
