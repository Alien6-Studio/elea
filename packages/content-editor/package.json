{
  "name": "@alien6-studio/elea-content-editor",
  "version": "0.1.5",
  "description": "Elea editor: React block editor with rich text, toolbar and injectable services",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Alien6-Studio/elea.git",
    "directory": "packages/content-editor"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./bundle.css": "./dist/bundle.css",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../../scripts/build-styles.mjs src/styles.css dist @alien6-studio/elea-tokens/elea.css @alien6-studio/elea-content-viewer/styles.css @alien6-studio/elea-media/styles.css @alien6-studio/elea-media/crop-adjustments.css @alien6-studio/elea-ui/styles.css",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@alien6-studio/elea-content": "^0.1.5",
    "@alien6-studio/elea-content-viewer": "^0.1.5",
    "@alien6-studio/elea-media": "^0.1.5",
    "@alien6-studio/elea-tokens": "^0.1.5",
    "@alien6-studio/elea-ui": "^0.1.5",
    "isomorphic-dompurify": "^4.8.0"
  },
  "peerDependencies": {
    "react": "^18.3.1 || ^19.0.0",
    "react-dom": "^18.3.1 || ^19.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "Apache-2.0",
  "homepage": "https://github.com/Alien6-Studio/elea/tree/main/packages/content-editor",
  "bugs": {
    "url": "https://github.com/Alien6-Studio/elea/issues"
  },
  "keywords": [
    "elea",
    "design-system",
    "block-editor",
    "rich-text",
    "react",
    "contenteditable"
  ]
}
