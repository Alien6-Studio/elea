{
  "name": "elea",
  "version": "0.0.0",
  "private": true,
  "description": "Elea design system by Alien6 Studio: design tokens, headless core, block content viewer and editor for React",
  "type": "module",
  "engines": {
    "node": ">=22 <25"
  },
  "workspaces": [
    "packages/*"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Alien6-Studio/elea.git"
  },
  "scripts": {
    "build": "npm run build --workspaces",
    "lint": "npm run lint --workspaces",
    "test": "node --import tsx --test 'packages/*/src/**/*.test.ts' 'packages/*/src/**/*.test.tsx'",
    "test:coverage": "c8 --check-coverage --lines 85 --statements 85 --functions 95 --branches 70 --reporter=lcov --reporter=text npm test",
    "test:package": "node scripts/check-package.mjs",
    "pack": "npm pack --workspaces --pack-destination artifacts",
    "check": "npm run lint && npm run test:coverage && npm run build && npm run test:package && npm pack --workspaces --dry-run"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "c8": "^12.0.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  },
  "license": "Apache-2.0",
  "homepage": "https://github.com/Alien6-Studio/elea",
  "bugs": {
    "url": "https://github.com/Alien6-Studio/elea/issues"
  }
}
